# Copier ce fichier en .env et renseigner les valeurs.
# Ne jamais commiter le fichier .env.

# --- LLM ---
# Fournisseur : gemini (seul adaptateur prévu pour l'instant)
LLM_PROVIDER=gemini
# Nom exact du modèle, à choisir dans la liste de Google AI Studio (variante « Flash » recommandée)
LLM_MODEL=
# Clé API à créer sur https://aistudio.google.com
LLM_API_KEY=

# --- Embeddings (RAG) ---
# Modèle local utilisé par ChromaDB, sans clé
# Alternative multilingue si le RAG répond mal en français : paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_MODEL=all-MiniLM-L6-v2

# --- Application ---
LOG_LEVEL=INFO
