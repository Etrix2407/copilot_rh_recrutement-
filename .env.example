# Copier ce fichier en .env et renseigner les valeurs.
# Ne jamais commiter le fichier .env.

# --- LLM ---
# Fournisseur : gemini (seul adaptateur prévu pour l'instant)
LLM_PROVIDER=gemini
# Nom exact du modèle, à choisir dans la liste de Google AI Studio (variante « Flash » recommandée)
LLM_MODEL=
# Clé API à créer sur https://aistudio.google.com
LLM_API_KEY=

# --- Embeddings (RAG) ---
# Modèle local utilisé par ChromaDB, sans clé (téléchargé au premier lancement, environ 80 Mo)
# Alternative multilingue si le RAG répond mal en français : paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_MODEL=all-MiniLM-L6-v2
# Tout autre modèle nécessite d'ajouter sentence-transformers aux dépendances
# Dossier où ChromaDB sauvegarde la base vectorielle (ignoré par Git)
CHROMA_PATH=chroma_db

# --- Application ---
LOG_LEVEL=INFO
# Origines du frontend autorisées à appeler l'API (format JSON)
CORS_ORIGINS=["http://localhost:5173"]
