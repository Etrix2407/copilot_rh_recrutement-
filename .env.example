# Copier ce fichier en .env et renseigner les valeurs.
# Ne jamais commiter le fichier .env.

# --- LLM ---
# Fournisseur : gemini (seul adaptateur prévu pour l'instant)
LLM_PROVIDER=gemini
# Nom exact du modèle, à choisir dans la liste de Google AI Studio (variante « Flash » recommandée)
LLM_MODEL=
# Clé API à créer sur https://aistudio.google.com
LLM_API_KEY=

# --- Embeddings (RAG) ---
# Modèle local utilisé par ChromaDB, sans clé (téléchargé au premier lancement, environ 80 Mo)
# Alternative multilingue si le RAG répond mal en français : paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_MODEL=all-MiniLM-L6-v2
# Tout autre modèle nécessite d'ajouter sentence-transformers aux dépendances
# Dossier où ChromaDB sauvegarde la base vectorielle (ignoré par Git)
CHROMA_PATH=chroma_db

# --- Application ---
LOG_LEVEL=INFO
# Base SQLite des candidats (dossier ignoré par Git)
DATABASE_PATH=storage/candidates.db
# Appels au LLM autorisés par minute et par adresse IP (analyse, RAG, chat)
LLM_REQUESTS_PER_MINUTE=10
# Autres origines autorisées à appeler l'API, au format JSON. Vide : l'interface est servie par l'API elle-même
CORS_ORIGINS=[]
# Noms d'hôte acceptés (protection contre le « DNS rebinding »), au format JSON
ALLOWED_HOSTS=["localhost", "127.0.0.1"]
# Date du jour donnée à l'agent (AAAA-MM-JJ), vide = vraie date. L'agenda du cahier des charges ne contient
# que les 15 et 16/10/2026 : pour une démo après cette date, mettre par exemple DEMO_DATE=2026-10-14
DEMO_DATE=
